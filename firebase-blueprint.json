{
  "entities": {
    "SiteConfig": {
      "title": "SiteConfig",
      "description": "Global romantic configuration for Zikri & Diann Our Little World",
      "type": "object",
      "properties": {
        "coupleNames": { "type": "string", "minLength": 1, "maxLength": 100 },
        "heroGreeting": { "type": "string", "minLength": 1, "maxLength": 300 },
        "couplePhotoUrl": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "finalLetter": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "secretHint": { "type": "string", "minLength": 1, "maxLength": 500 },
        "secretCodeHash": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$" },
        "secretMessage": { "type": "string", "minLength": 1, "maxLength": 5000 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["coupleNames", "heroGreeting", "couplePhotoUrl", "finalLetter", "secretHint", "secretCodeHash", "secretMessage", "ownerUid", "createdAt", "updatedAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private non-PII user pairing state storing active couple space ID and partner role",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "roleName": { "type": "string", "enum": ["Zikri", "Diann"] },
        "spaceId": { "type": "string", "minLength": 0, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "roleName", "spaceId", "createdAt", "updatedAt"]
    },
    "InviteCode": {
      "title": "InviteCode",
      "description": "Unique single-use couple invitation code mapping to a CoupleSpace",
      "type": "object",
      "properties": {
        "code": { "type": "string", "minLength": 6, "maxLength": 12, "pattern": "^[A-Z0-9]{6,12}$" },
        "spaceId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "creatorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "isActive": { "type": "boolean" },
