        "sharedSongArtist": { "type": "string", "minLength": 0, "maxLength": 140 },
        "sharedSongPlaying": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
